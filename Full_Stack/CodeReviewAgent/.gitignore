# === Backend (Python) ===

# Ignore the virtual environment folder
backend/venv/

# IMPORTANT: Ignore the .env file with your API key
backend/.env

# Ignore Python cache
backend/__pycache__/
*.pyc


# === Frontend (Node/VVite) ===

# Ignore dependencies
frontend/node_modules

# Ignore build artifacts
frontend/dist
frontend/dist-ssr

# Ignore logs
frontend/logs
frontend/*.log
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*
frontend/lerna-debug.log*

# Ignore local env files
frontend/*.local


# === Editor & OS ===

# Ignore OS-generated files
.DS_Store

# Ignore editor-specific files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?